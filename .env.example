# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# Admin username and password (choose a long unique password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Session signing secret: at least 32 random characters
SESSION_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARACTERS
# Optional: set to 1 behind HTTPS in production
COOKIE_SECURE=1
