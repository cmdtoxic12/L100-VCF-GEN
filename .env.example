# ---------------------------------------------------------------------------
# Server-side only. Never expose these to the browser (no VITE_ prefix).
# ---------------------------------------------------------------------------

# Neon / Postgres connection string
# Neon Console -> your project -> Connection Details -> Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Admin dashboard password. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
